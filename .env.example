# Copy to .env for local runs outside Docker. Compose reads JWT_SECRET, ADMIN_TOKEN,
# REDIS_FAILURE_POLICY from the shell or a .env file.
DATABASE_URL=postgresql+asyncpg://ratelimiter:ratelimiter@localhost:5434/ratelimiter
REDIS_URL=redis://localhost:6381/0
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-to-a-long-random-string
REDIS_FAILURE_POLICY=closed
